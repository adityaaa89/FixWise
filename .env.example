# ============================================================================
# Environment Variables: Repair or Replace Advisor & Adaption Platform
# ============================================================================

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./advisor.db
# For PostgreSQL: postgresql://user:password@localhost:5432/advisor_db

# Adaption AI Labs Credentials
ADAPTION_API_KEY=pt_live_your_api_key_here
ADAPTION_API_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
ADAPTION_CREDIT_BUDGET=5000
ADAPTION_MOCK_MODE=false

# Google Gemini / Vision API (For model sticker rating plate extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0

